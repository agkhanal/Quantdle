# Secret used to encrypt puzzle tokens and sign login sessions.
# Any long random string. Set it in production.
QUANTDLE_SECRET=

# Leaderboard + accounts database (Upstash Redis, free tier).
# On Vercel: Storage tab -> add Upstash Redis, and these are filled in for you.
# Leave empty locally to use an in-memory store that resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Turns on the AI judge (and "Show your work") for wrong answers.
ANTHROPIC_API_KEY=

# Optional. Set to 1 (with ANTHROPIC_API_KEY) to have Claude write Practice
# puzzles instead of the built-in generator.
QUANTDLE_AI_PUZZLES=
# Optional. Turns on "Continue with Google". Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add this authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback   (and your production domain's equivalent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the app sits behind a proxy and the redirect URI can't be inferred.
GOOGLE_REDIRECT_URI=

# Optional. Turns on the admin points tool (POST /api/admin/points with
# "Authorization: Bearer <this secret>"). Leave empty to keep it switched off.
# Generate one with: openssl rand -hex 32
QUANTDLE_ADMIN_SECRET=

# Optional. Turns on PostHog analytics: pageviews, live users, session replays and
# game events, viewable in your PostHog project. Use the project API key from
# https://us.posthog.com/settings/project. Leave empty to keep analytics off.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional. The site's public address, used for link-preview images when it's shared
# on X, LinkedIn, Slack and so on. Defaults to https://quantdle.vercel.app.
NEXT_PUBLIC_SITE_URL=
