# Secret used to encrypt puzzle tokens and sign login sessions.
# Any long random string. Set it in production.
QUANTDLE_SECRET=

# Leaderboard + accounts database (Upstash Redis, free tier).
# On Vercel: Storage tab -> add Upstash Redis, and these are filled in for you.
# Leave empty locally to use an in-memory store that resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Turns on the AI judge (and "Show your work") for wrong answers.
ANTHROPIC_API_KEY=

# Optional. Set to 1 (with ANTHROPIC_API_KEY) to have Claude write Practice
# puzzles instead of the built-in generator.
QUANTDLE_AI_PUZZLES=